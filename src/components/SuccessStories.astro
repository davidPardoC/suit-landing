---
import { t, type Lang } from "../i18n/translations";
import { Users, Gift, Store, Building2, ReceiptText, Clock3 } from "lucide-react";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;

const metricIcons = {
  Upoints: [Users, Gift, Store],
  Propi: [Building2, ReceiptText, Clock3],
};

const cases = [
  {
    name: "Upoints",
    logo: "/Upointslogo.webp",
    dash: "/dash_upoints.webp",
    url: "https://upoints.ec/",
    categoryKey: "successStories.upoints.category",
    resultKey: "successStories.upoints.result",
    metrics: [
      { value: "20", labelKey: "successStories.upoints.metric1" },
      { value: "450", labelKey: "successStories.upoints.metric2" },
      { value: "12", labelKey: "successStories.upoints.metric3" },
    ],
    testimonialKey: "successStories.upoints.testimonial",
  },
  {
    name: "Propi",
    logo: "/Propilogo.webp",
    dash: "/dash_propi.webp",
    url: "https://propi.suitsoftware.com/",
    categoryKey: "successStories.propi.category",
    resultKey: "successStories.propi.result",
    metrics: [
      { value: "8", labelKey: "successStories.propi.metric1" },
      { value: "2.4K", labelKey: "successStories.propi.metric2" },
      { value: "15 min", labelKey: "successStories.propi.metric3" },
    ],
    testimonialKey: "successStories.propi.testimonial",
  },
];
---

<section id="success-stories" class="py-20 lg:py-28 bg-surface-50 dark:bg-surface-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-flex items-center gap-2 px-4 py-2 text-xs font-bold tracking-wide uppercase rounded-full bg-accent-100 dark:bg-accent-900/30 text-accent-700 dark:text-accent-400 border border-accent-200 dark:border-accent-800 mb-4">
        {t(lang, "successStories.label")}
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-surface-900 dark:text-white text-balance font-sans">
        {t(lang, "successStories.title")}
      </h2>
      <p class="mt-6 text-lg sm:text-xl text-surface-600 dark:text-surface-300">
        {t(lang, "successStories.description")}
      </p>
    </div>

    <!-- Cases Grid -->
    <div class="grid md:grid-cols-2 gap-6 lg:gap-8">
      {cases.map((caseStudy) => (
        <div class="bg-white dark:bg-surface-800 rounded-2xl border border-surface-200 dark:border-surface-700 shadow-lg shadow-surface-900/5 dark:shadow-surface-900/10 transition-all duration-300 hover:shadow-xl hover:shadow-brand-900/10 dark:hover:shadow-brand-400/10 hover:-translate-y-1 overflow-hidden group reveal-on-scroll">
          <!-- Browser Frame + Dashboard Screenshot -->
          <div>
            <div class="flex items-center gap-1.5 px-4 py-2.5 bg-surface-100 dark:bg-surface-700 border-b border-surface-200 dark:border-surface-700">
              <div class="w-3 h-3 rounded-full bg-red-500"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
              <div class="w-3 h-3 rounded-full bg-green-500"></div>
            </div>
            <div class="aspect-[16/10] overflow-hidden bg-surface-100 dark:bg-surface-700">
              <img
                src={caseStudy.dash}
                alt={t(lang, caseStudy.resultKey)}
                loading="lazy"
                class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </div>
          </div>

          <!-- Card Content -->
          <div class="p-5 lg:p-6">
            <div class="grid md:grid-cols-2 gap-5 lg:gap-6">
              <!-- Left Column: Identity + Result -->
              <div class="flex flex-col">
                <!-- Logo + Name + Category -->
                <div class="flex items-center gap-3">
                  <div class="w-12 h-12 bg-surface-100 dark:bg-surface-700 rounded-xl flex items-center justify-center p-2 shrink-0">
                    <img
                      src={caseStudy.logo}
                      alt={caseStudy.name}
                      class="w-full h-full object-contain"
                    />
                  </div>
                  <div>
                    <h3 class="text-lg lg:text-xl font-black tracking-tight text-surface-900 dark:text-white font-sans leading-tight">{caseStudy.name}</h3>
                    <p class="text-xs tracking-wide text-surface-400 dark:text-surface-500">{t(lang, caseStudy.categoryKey)}</p>
                  </div>
                </div>
                <!-- Result headline -->
                <p class="mt-4 text-xl lg:text-2xl font-black text-brand-600 dark:text-brand-400 leading-tight tracking-tight">
                  {t(lang, caseStudy.resultKey)}
                </p>
              </div>

              <!-- Right Column: Metrics + Testimonial + CTA -->
              <div class="flex flex-col justify-between">
                <!-- Metrics grid -->
                <div class="grid grid-cols-3 gap-2">
                  {caseStudy.metrics.map((metric, index) => {
                    const Icon = metricIcons[caseStudy.name as keyof typeof metricIcons][index];
                    return (
                      <div class="flex flex-col items-center gap-1">
                        <div class="text-xl lg:text-2xl font-black leading-tight tracking-tight tabular-nums text-surface-900 dark:text-white">
                          {metric.value}
                        </div>
                        <div class="inline-flex items-center gap-1 text-xs font-medium leading-tight text-surface-500 dark:text-surface-400">
                          <Icon className="h-[1.6em] w-[1.6em] shrink-0 text-brand-500/70 dark:text-brand-400/70" />
                          <span>{t(lang, metric.labelKey)}</span>
                        </div>
                      </div>
                    );
                  })}
                </div>

                <!-- Testimonial + CTA -->
                <div class="mt-4 pt-4 border-t border-surface-100 dark:border-surface-700">
                  <p class="text-sm text-surface-400 dark:text-surface-500 italic leading-relaxed">
                    "{t(lang, caseStudy.testimonialKey)}"
                  </p>
                  <div class="flex justify-end mt-3">
                    <a
                      href={caseStudy.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 px-4 py-2 text-sm font-bold text-white bg-brand-600 hover:bg-brand-700 dark:bg-brand-500 dark:hover:bg-brand-600 rounded-lg transition-colors"
                    >
                    {t(lang, "successStories.cta")}
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                    </svg>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>